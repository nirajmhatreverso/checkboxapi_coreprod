3. Python - using requests (very common in automation)
Python

import requests
import json

payload = {
    "cmts_device": {
        "host": "192.168.88.55",
        "device_type": "cisco_ios",
        "username": "admin",
        "password": "cisco123",
        "secret": "cisco123",
        "port": 22,
        "global_delay_factor": 2
    },
    "commands": [
        "terminal length 0",
        "show version",
        "show ip arp | include 10.10.10"
    ],
    "login_type": "ssh",
    "regexPattern": "[>#]",
    "lineSeperator": "@@@@@"
}

url = "http://127.0.0.1:8000/api/execute/"

try:
    response = requests.post(url, json=payload, timeout=120)
    response.raise_for_status()  # raise exception for bad status codes
    
    data = response.json()
    
    print("Status:", data.get("status"))
    print("Host:", data.get("host"))
    print(f"Executed {data.get('command_count')} commands\n")
    
    for i, output in enumerate(data.get("outputs", []), 1):
        print(f"--- Output {i} ---")
        print(output)
        print("-"*60)

except requests.exceptions.RequestException as e:
    print("Error:", str(e))
    if hasattr(e.response, 'text'):
        print("Server response:", e.response.text)

Quick Checklist – Most Common Problems
Problem	Most likely cause	Fix suggestion
400 Bad Request	Wrong JSON structure / missing fields	Compare with /info/ response
Connection timeout	Wrong IP / firewall / device unreachable	Ping the device first
Authentication failed	Wrong username/password/secret	Double-check credentials
500 Internal Server Error	Netmiko error (look in logs/cmts_api.log)	Check server logs
Empty outputs	Wrong prompt pattern / command too fast	Try "regexPattern": "[>#]$"

