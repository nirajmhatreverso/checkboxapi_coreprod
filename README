│   ├── __init__.py
│   ├── settings.py
│   ├── urls.py
│   └── ...
├── api/                    ← your existing app
├── utils/                  ← ← ← create this folder (recommended)
│   ├── __init__.py
│   ├── db.py               ← ← ← put Oracle raw connection here
│   └── ...
└── manage.py

utils/db.py – Recommended pattern (2025–2026 style)
Python

# utils/db.py
import oracledb
from django.conf import settings
from contextlib import contextmanager
import logging

logger = logging.getLogger(__name__)

# Option A: Use credentials directly (less secure, but simple)
# CONNECTION_PARAMS = {
#     "user": "reports",
#     "password": "2322",
#     "dsn": "172.20.20.24:1213/misdb"
# }

# Option B: Better – store in Django settings (recommended)
# settings.py:
# ORACLE_DB = {
#     'USER': 'reports',
#     'PASSWORD': '2322',
#     'HOST': '172.20.20.24',
#     'PORT': 1213,
#     'SERVICE_NAME': 'misdb'
# }

@contextmanager
def get_oracle_connection():
    """Context manager for safe Oracle connection handling"""
    conn = None
    try:
        # Modern way - using service name (preferred)
        conn = oracledb.connect(
            user=settings.ORACLE_DB['USER'],
            password=settings.ORACLE_DB['PASSWORD'],
            dsn=f"{settings.ORACLE_DB['HOST']}:{settings.ORACLE_DB['PORT']}/{settings.ORACLE_DB['SERVICE_NAME']}"
            # min=1, max=10, increment=1   ← you can add pool if needed
        )
        logger.debug("Oracle connection opened")
        yield conn
    except oracledb.Error as e:
        logger.error(f"Oracle connection failed: {e}")
        raise
    finally:
        if conn:
            try:
                conn.close()
                logger.debug("Oracle connection closed")
            except:
                pass


# Example usage in views.py / services / anywhere
def some_business_function():
    with get_oracle_connection() as conn:
        cursor = conn.cursor()
        
        # SELECT example
        cursor.execute("""
            SELECT id, name, amount 
            FROM transactions 
            WHERE status = 'PENDING' 
            AND created_at > SYSDATE - 7
        """)
        rows = cursor.fetchall()
        
        # INSERT example
        cursor.execute("""
            INSERT INTO processed_logs (transaction_id, processed_at, status)
            VALUES (:1, SYSDATE, 'SUCCESS')
        """, [12345])
        
        conn.commit()           # very important!

Quick Summary – What to choose in 2026
text

You want to do raw SELECT + INSERT                  →   utils/db.py + context manager     (recommended)
You use Django models mapped to Oracle tables       →   settings.DATABASES['oracle']      (cleanest)
You need connection pooling for high load           →   oracledb.create_pool() in utils
You do one-time migration / report generation       →   custom management command
You do heavy background processing                  →   Celery task + utils/db.py

Most probably for your current situation
→ create utils/db.py with context manager
→ put credentials in settings.py (or better – environment variables)
→ import and use with get_oracle_connection() as conn: wherever you need raw SQL

