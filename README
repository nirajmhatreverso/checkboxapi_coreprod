Here are the most common and practical ways to use / call / access
the Oracle database you configured in settings.py → DATABASES['oracle']
1. Using Django ORM (recommended if you have models)
Python

# In any file (views.py, services, management command, etc.)

from django.db import connections

# Get cursor from oracle connection
with connections['oracle'].cursor() as cursor:
    cursor.execute("SELECT * FROM your_table WHERE id = :1", [123])
    rows = cursor.fetchall()
    
    for row in rows:
        print(row)

Python

# Or using raw SQL with connection
with connections['oracle'].cursor() as cursor:
    cursor.execute("""
        INSERT INTO some_table (col1, col2, created_at)
        VALUES (:1, :2, SYSDATE)
    """, ['value1', 999])
    
    connections['oracle'].commit()   # ! important !

2. Using raw oracledb connection (most flexible – recommended for your case)
Python

# utils/db.py   ← recommended place

import oracledb
from django.conf import settings
from contextlib import contextmanager

@contextmanager
def get_oracle_cursor():
    """
    Returns cursor from the same connection that Django uses
    (uses connection pooling if Django is configured properly)
    """
    conn = None
    try:
        # This uses the exact same credentials as in settings.DATABASES['oracle']
        conn = connections['oracle'].get_new_connection()
        cursor = conn.cursor()
        yield cursor, conn
    finally:
        if cursor:
            cursor.close()
        if conn:
            # Don't close connection - Django's connection pool will handle it
            pass


# Usage example anywhere in project
def some_function():
    try:
        with get_oracle_cursor() as (cursor, conn):
            cursor.execute("""
                SELECT id, name, amount 
                FROM transactions 
                WHERE status = 'PENDING'
            """)
            rows = cursor.fetchall()

            # Do something with data...
            
            # Insert example
            cursor.execute("""
                INSERT INTO processed_logs (trans_id, processed_date, status)
                VALUES (:1, SYSDATE, :2)
            """, [1001, 'SUCCESS'])
            
            conn.commit()                    # ← very important!
            
    except oracledb.Error as error:
        print("Oracle error:", error)
        if 'conn' in locals():